# panopticon-fixtures: vulnerable-by-design applications for scanner validation.
# Build:  docker build -f Dockerfile.fixtures -t panopticon-fixtures:latest .
# Rebuild: docker build --no-cache -f Dockerfile.fixtures -t panopticon-fixtures:$(date +%Y-%m-%d) .
# DL3006/DL3007: base image is the freshly-built local `panopticon-tools:latest`
# produced by the docker-build-pr workflow; a static tag is intentional here.
# hadolint ignore=DL3006,DL3007
FROM panopticon-tools:latest

# DL3002: root here is a BUILD-time decision. The layers below install a JDK,
# clone three goat fixtures and run bundler, maven, cargo and dotnet against
# them, all as this USER. It says nothing about who should RUN the image, and
# this image is no longer local-only: `.github/workflows/adapter-integration.yml`
# builds and runs it daily, and that is the ONLY gate where the adapters meet
# real tools and real fixtures.
#
# The RUNTIME user is the caller's, and CI states it (ARC-2930403871, #1771):
# both jobs there pass `--user scanner`, so the probes run as the user every
# production scan runs as (the tools image's `useradd -m -u 1000 scanner` and
# its closing `USER scanner`), and each asserts `id -u` inside the
# container before running a probe. Without that, the harness proved the
# adapters at a privilege production never has, and a root-only regression --
# the #1877 class, a tool refusing its input under the real uid -- passed the
# one gate that could catch it.
#
# What a non-root scan has to be able to READ is handled below rather than left
# to the flag: `ENV NUGET_PACKAGES=/opt/nuget-packages` moves the .NET global
# package folder out of root's 0700 HOME before the two restores write its
# absolute path into `project.assets.json`, `chmod -R a+rX` on it afterwards
# opens it, and a chown of the cargo subtrees this build dirties hands those
# back to `scanner`, whose home they are. What is
# still root-only is /root/.m2 (WebGoat's maven repo) and /root/.dotnet (a
# first-run sentinel): no scan reads either -- the jars a source-tree scan looks
# at are copied into `WebGoat/target/dependency` by the block that says so, and
# dotnet rewrites its sentinel under whatever HOME it is given -- and opening
# /root in an image that runs a hostile MSBuild target is the wrong direction.
#
# A runtime `USER scanner` at the end of this file is therefore no longer
# blocked by a cache. It is still not here because it is the wrong half of the
# remaining work, not because the remaining work is unwanted: the local harness
# (`skill/scripts/run_fixture_tests.py`) also runs this image with no `--user`,
# and it SHOULD run as the scan user -- that is the point of ARC-2930403871, and
# it is tracked on #1771. What it needs is the loud version of this posture, the
# flag plus the same `id -u` assertion the CI lanes carry, rather than a baked
# default that would change the uid with nothing on the command line to say so.
# The other half of the argument stands on its own: nothing in this file can
# prove /root/.m2 and /root/.dotnet unread without running the image.
# hadolint ignore=DL3002
USER root

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# OpenJDK for WebGoat. Ruby, Node.js/npm, and .NET 8.0 are already provided
# by the panopticon-tools base image. This one distro package is intentionally
# unpinned, and NOT because the image is local-only -- it is not, CI runs it
# daily (see the USER block above). The reason is rotation: Debian moves JDK
# point releases off the mirror, so a pinned `openjdk-21-jdk-headless=...`
# breaks the build on a mirror refresh rather than on anything real. What the
# image validates AGAINST is pinned where it matters: the three fixture SHAs
# below, `requirements-fixtures.txt` by hash, and the base image's own tools.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-21-jdk-headless \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/panopticon-fixtures

# Clone public fixtures at build time, pinned to immutable commit SHAs. A mutable
# `--branch` ref (these were `main`) can silently change the vendored vulnerable
# corpus under us — a supply-chain risk for a fixtures image whose whole purpose is
# a KNOWN set of planted vulnerabilities (#1252, SEC-E2C). Fetch-by-SHA mirrors the
# semgrep-rules pin above (see the /opt/semgrep-rules block). To bump a fixture:
# resolve the new commit (`git ls-remote <url> <ref>`) and update the SHA below.
ARG RAILS_GOAT_SHA=0222f7da3406ba3ab637bc6d24ae9366b5f0a680
RUN git init -q railsgoat \
    && git -C railsgoat remote add origin https://github.com/OWASP/railsgoat.git \
    && timeout 120 git -C railsgoat fetch -q --depth 1 origin ${RAILS_GOAT_SHA} \
    && git -C railsgoat checkout -q FETCH_HEAD                          # OWASP/railsgoat @ main 2026-08-23

ARG WEB_GOAT_SHA=5357a65e054976cd7d79b81ef3906ded050ed921
RUN git init -q WebGoat \
    && git -C WebGoat remote add origin https://github.com/WebGoat/WebGoat.git \
    && timeout 120 git -C WebGoat fetch -q --depth 1 origin ${WEB_GOAT_SHA} \
    && git -C WebGoat checkout -q FETCH_HEAD                            # WebGoat/WebGoat v2023.8

# AspGoat is only published as a personal fork; SHA-pinning removes the mutable-ref
# drift risk, but the fork provenance itself is an accepted risk — replace with an
# upstream/vendored source if one becomes available.
ARG ASP_GOAT_SHA=db3153f5dae036a9d67e12be22548299855c6b40
RUN git init -q AspGoat \
    && git -C AspGoat remote add origin https://github.com/Soham7-dev/AspGoat.git \
    && timeout 120 git -C AspGoat fetch -q --depth 1 origin ${ASP_GOAT_SHA} \
    && git -C AspGoat checkout -q FETCH_HEAD                            # Soham7-dev/AspGoat @ main 2026-08-23

# Prepare fixture dependencies when possible; static-analysis tests tolerate missing deps.
# hadolint ignore=DL3003
RUN cd /opt/panopticon-fixtures/railsgoat && (bundle install || echo "railsgoat bundle install skipped")
# `compile` leaves the dependency jars in ~/.m2, OUTSIDE the project tree, and
# produces no packaged artifact -- so dependency-check scanning the source tree
# saw exactly ONE dependency (the maven wrapper) and reported zero
# vulnerabilities, which is indistinguishable from a clean scan. Copying them
# into target/dependency puts them where a source-tree scan actually looks.
#
# Then PRUNE to a bounded subset. The full set is 234 jars, which dependency-check
# takes ~15 minutes to analyse -- against the adapter's own 900s timeout, so the
# fixture would fail intermittently on timing alone rather than on anything real.
# The cap is deterministic (sorted, first N) so the corpus does not shift between
# builds, and it is well above what the test needs: it asserts that CVEs are
# found and parsed, not how many.
ARG WEBGOAT_JAR_CAP=45
# hadolint ignore=DL3003
RUN cd /opt/panopticon-fixtures/WebGoat \
    && (./mvnw clean compile -DskipTests || mvn clean compile -DskipTests || echo "WebGoat compile skipped") \
    && (./mvnw dependency:copy-dependencies -DskipTests || mvn dependency:copy-dependencies -DskipTests || echo "WebGoat dependency copy skipped") \
    && if [ -d target/dependency ]; then \
         find target/dependency -name '*.jar' | sort | tail -n +$((WEBGOAT_JAR_CAP + 1)) | xargs -r rm -f; \
         echo "WebGoat jars kept: $(find target/dependency -name '*.jar' | wc -l)"; \
       fi
# ARC-2930403871 (#1771): the NuGet global packages folder, OUT of root's home.
# Both .NET restores below run as root (this image builds as root), and NuGet's
# default global folder is `$HOME/.nuget/packages` -- /root/.nuget/packages
# here, under a directory Debian ships as mode 0700. The restore writes the
# resolved absolute path into each project's `obj/project.assets.json`, so a
# scan running as `scanner` (uid 1000, which is how CI now runs this image and
# how every production scan runs the tools image) could not read a single
# package: roslyn-secguard would report an empty result, which is
# indistinguishable from a clean one -- the #1655 defect the bake exists to
# prevent, reappearing through the uid instead of through a skipped restore.
#
# Named here rather than fixed with a chmod on /root: this image runs the
# hostile MSBuild fixture, so making root's home traversable is the wrong
# direction. The ENV lives in the fixtures image only -- the tools image
# production scans with is `FROM`-parent to this and does not carry it.
ENV NUGET_PACKAGES=/opt/nuget-packages
# hadolint ignore=DL3003
RUN cd /opt/panopticon-fixtures/AspGoat && (dotnet restore && dotnet build --no-restore || echo "AspGoat build skipped")

# Copy the hand-rolled Rust fixture from the repo.
# The fixture must include a committed Cargo.lock so cargo-audit has a dependency graph to audit.
COPY tests/fixtures/vulnerable-rust /opt/panopticon-fixtures/vulnerable-rust
# hadolint ignore=DL3003
RUN cd /opt/panopticon-fixtures/vulnerable-rust && cargo build
# ...and give `scanner` back the parts of its CARGO_HOME this build dirtied
# (ARC-2930403871). `CARGO_HOME` is inherited from the base image as
# /home/scanner/.cargo (its `ENV CARGO_HOME=/home/scanner/.cargo`), which the
# base creates and chowns FOR scanner (`mkdir -p /home/scanner/.cargo` then
# `chown scanner:scanner`), so the build above filled production's own writable
# cargo home with root-owned files: the downloaded crate cache and index under
# `registry/`, the `git/` checkouts if a dependency is a git one, and the
# `.package-cache` lock cargo takes while it works. Those, by name, and NOT the
# whole directory: `advisory-db` beside them is the RustSec clone the base image
# deliberately leaves read-only (`chmod -R a+rX /home/scanner/.cargo`), and this
# is the image that executes a hostile MSBuild target -- handing it a writable
# advisory database buys nothing. `cargo-audit --no-fetch` reads the lockfile
# and that read-only DB, so this is the invariant rather than a live break, and
# restoring it beats pointing CARGO_HOME elsewhere, which would move
# `advisory-db` out from under `cargo-audit` and degrade it silently.
#
# `if [ -e ]` per entry rather than one chown: `git/` exists only when a
# dependency is fetched from git, and naming an absent path would fail the build
# for the one cache shape that is allowed not to appear. A chown that FAILS
# still fails the build -- it is inside the `if`, not guarded with `|| true`.
RUN for d in registry git .package-cache .global-cache; do \
      if [ -e "/home/scanner/.cargo/$d" ]; then \
        chown -R scanner:scanner "/home/scanner/.cargo/$d"; \
      fi; \
    done

# The hostile C# fixture (#1655). roslyn-secguard refuses a target with no NuGet
# restore output (`project.assets.json`): a C# project that has not been restored
# compiles to nothing and the scan reports an empty result, which is
# indistinguishable from a clean one. The containment lane scans a read-only
# mount with `--network none`, so the restore cannot happen at scan time -- it
# happens here, with a network, exactly as it does for AspGoat above.
#
# RESTORE ONLY, never `dotnet build`. evil.csproj's `Hostile` target is hooked
# `BeforeTargets="Build"`, so it fires when the project is BUILT -- which is the
# act the containment probe performs, inside the no-egress container, on the
# adapter's throwaway copy. Building it here would run its live `curl` on the
# image builder, which has a network. Restore runs no Build target, and
# tests/test_dockerfile.py pins that this line stays a restore.
#
# Deliberately NOT tolerated with `|| echo ... skipped` the way AspGoat's build
# is: a skipped restore produces an image whose containment lane then fails on
# applicability, reporting a decorative probe instead of a broken image -- the
# exact defect this line exists to remove. A failed restore fails the build.
COPY tests/fixtures/hostile-csproj /opt/panopticon-fixtures/hostile-csproj
RUN dotnet restore /opt/panopticon-fixtures/hostile-csproj/evil.csproj

# Both restores are done: make what they cached readable to the user the scans
# run as (ARC-2930403871). `a+rX` and not a chown, for the same reason the base
# image uses it on its own baked assets (`chmod -R a+rX /opt/semgrep-rules`,
# `/opt/osv-db`, `/opt/trivy-cache`, `/home/scanner/.cargo`,
# `/root/.local/share/ruby-advisory-db`): the scan only READS packages.
# `/opt/odc-data` is the counter-example the base image documents beside its
# `chown -R scanner:scanner /opt/odc-data` -- dependency-check opens its H2 file
# read-write, and H2 BLOCKS rather than failing when it cannot lock -- so that
# one is chowned. If NuGet turns out to need a write inside the global folder,
# this line becomes the same chown.
#
# `mkdir -p` first, because the directory is a side effect of a restore that is
# allowed to fail: AspGoat's is wrapped `|| echo "AspGoat build skipped"` BY
# DESIGN (a flaky public feed must not fail the image), and evil.csproj declares
# no `PackageReference` at all, so neither restore is a dependable creator of
# the folder. Without the `mkdir`, a NuGet hiccup during the AspGoat restore
# would stop failing one C# probe loudly in `integration` and start failing the
# fixtures-image BUILD in both jobs, including `containment`, which has nothing
# to do with C# packages.
RUN mkdir -p /opt/nuget-packages && chmod -R a+rX /opt/nuget-packages

# Note: skill/scripts/ and tests/ are mounted read-only at runtime so the harness
# always uses the current repo's code; do not COPY them into the image.

# pytest is needed by the integration-test harness that runs inside this image.
# #1641 (SEC-E2A): by version AND by digest. This install runs as root at image
# build, so an unconstrained resolve executes an attacker-chosen release's
# install-time code with full privileges inside the very image the scanner
# adapters are validated against -- and pyproject.toml's `pytest>=9.1.1` floor
# does not reach this separate command. --require-hashes makes pip refuse any
# artifact whose sha256 is not in the file, a missing transitive dependency
# included; `scripts/bump_pins.py requirements --write` is what writes them.
COPY requirements-fixtures.txt /tmp/requirements-fixtures.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-fixtures.txt \
    && rm /tmp/requirements-fixtures.txt

ENV PYTHONPATH=/opt/panopticon
ENV FIXTURE_ROOT=/opt/panopticon-fixtures
WORKDIR /opt/panopticon

# Build-time root, as the USER block at the top explains; the runtime user is
# the caller's. This CMD is the local harness. CI overrides both the user and
# the command (`--user scanner`, `--entrypoint sh ... pytest tests/tools/`), so
# "for local test use only" is no longer true of this image and is not claimed.
CMD ["python", "skill/scripts/run_fixture_tests.py"]
