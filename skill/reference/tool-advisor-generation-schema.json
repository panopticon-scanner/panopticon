{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PanopticonToolAdvisorGeneration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "REJECTED",
        "NEEDS_MORE_INFO"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "CERTAIN",
        "LIKELY",
        "POSSIBLE"
      ]
    },
    "reasoning": {
      "type": "string"
    },
    "explored": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cwe": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owasp": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "cwe",
        "owasp",
        "cve"
      ]
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "finding_id",
    "verdict",
    "confidence",
    "reasoning",
    "explored",
    "references",
    "citations",
    "missing_evidence"
  ]
}
