{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeReviewReport",
  "type": "object",
  "required": ["meta", "summary", "groups", "findings", "cross_panel"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["target", "review_type", "timestamp", "version", "security_mode"],
      "properties": {
        "target": {"type": "string"},
        "review_type": {"type": "string", "enum": ["repo", "file", "directory", "group", "changes", "pr"]},
        "timestamp": {"type": "string"},
        "version": {"type": "string"},
        "security_mode": {"type": "string", "enum": ["standard", "redteam"]},
        "parts": {"type": "array", "items": {"type": "string"}},
        "models_used": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "model": {"type": "string"},
              "version": {"type": "string"},
              "role": {"type": "string"}
            }
          }
        },
        "build_executing_tools": {"type": "array", "items": {"type": "string"}, "description": "Names of adapters from EXECUTES_TARGET_BUILD that contributed findings to this report."},
        "tool_policy_mode": {"type": "string", "enum": ["enforced", "advisory", "mixed"], "description": "Posture of the fan-out reviewer entries (panel_review/lens_sweep) derived from dispatch plans; scout/advisor posture is not recorded."}
      }
    },
    "summary": {
      "type": "object",
      "required": ["overall_grade", "risk_level", "top_issues", "gate"],
      "properties": {
        "overall_grade": {"type": "string", "enum": ["A", "B", "C", "D", "F"]},
        "risk_level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "top_issues": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
        "gate": {"type": "string", "enum": ["PASS", "FAIL", "OFF"]},
        "gate_policy": {"type": "string", "enum": ["confirmed_only", "include_unverified"]},
        "evidence_stats": {
          "type": "object",
          "properties": {
            "tool_confirmed": {"type": "integer"},
            "advisor_confirmed": {"type": "integer"},
            "corroborated": {"type": "integer"},
            "needs_more_info": {"type": "integer"},
            "unverified": {"type": "integer"},
            "rejected": {"type": "integer"}
          }
        },
        "stats": {"type": "object"}
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "files", "panel_grades"],
        "properties": {
          "name": {"type": "string"},
          "files": {"type": "array", "items": {"type": "string"}},
          "panel_grades": {"type": "object"},
          "key_findings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "confidence", "panel", "category", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{3,}$"},
          "title": {"type": "string"},
          "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
          "confidence": {"type": "string", "enum": ["CERTAIN", "LIKELY", "POSSIBLE", "NOTE"]},
          "panel": {"type": "string", "enum": ["code", "test", "security", "architecture", "database", "redteam"]},
          "lens": {"type": "string"},
          "category": {"type": "string"},
          "source_role": {"type": "string", "enum": ["lens_sweep", "panel_review", "advisor"]},
          "depth": {"type": "string", "enum": ["shallow", "standard", "deep"]},
          "location": {
            "type": "object",
            "required": ["file", "line_start"],
            "properties": {
              "file": {"type": "string"},
              "line_start": {"type": "integer"},
              "line_end": {"type": "integer"},
              "function": {"type": "string"}
            }
          },
          "description": {"type": "string"},
          "impact": {"type": "string"},
          "remediation": {"type": "string"},
          "references": {"type": "array", "items": {"type": "string"}},
          "cvss": {"type": "object", "properties": {"score": {"type": "number"}, "vector": {"type": "string"}}},
          "exploit_scenario": {"type": "string"},
          "source": { "type": "string" },
          "reinforced": { "type": "boolean" },
          "corroborated": { "type": "boolean" },
          "corroborated_by": { "type": "array", "items": { "type": "string" } },
          "citation_quality": {
            "type": "string",
            "enum": ["full", "partial", "minimal", "none"]
          },
          "evidence": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["tool_confirmed", "advisor_confirmed", "corroborated", "needs_more_info", "unverified", "rejected"]
              },
              "verified_by": {},
              "reasoning": {"type": ["string", "null"]},
              "citation_quality": {"type": "string", "enum": ["full", "partial", "minimal", "none"]}
            }
          },
          "provenance": {
            "type": "object",
            "properties": {
              "discovered_by": { "type": "string" },
              "expanded_by": { "type": ["string", "null"] },
              "confirmed_by": { "type": ["string", "null"] },
              "model": { "type": ["string", "null"] },
              "model_version": { "type": ["string", "null"] },
              "confirmed_by_model": { "type": ["string", "null"] },
              "confirmation_status": {
                "type": "string",
                "enum": ["TOOL", "CONFIRMED", "REJECTED", "NEEDS_MORE_INFO", "UNVERIFIED"]
              },
              "confirmation_reasoning": { "type": ["string", "null"] }
            }
          },
          "citations": {
            "type": "object",
            "properties": {
              "cwe": { "type": "array", "items": { "anyOf": [{ "type": "string" }, { "type": "object" }] } },
              "owasp": { "type": "array", "items": { "type": "string" } },
              "ssvc": { "type": "object" },
              "cve": { "type": "array", "items": { "type": "string" } },
              "epss": { "type": "array", "items": { "type": "object" } }
            }
          },
          "tool_evidence": {
            "type": "object",
            "properties": {
              "rule_id": { "type": "string" },
              "advisory_url": { "type": "string" },
              "package_name": { "type": "string" },
              "vulnerable_versions": { "type": "string" },
              "fixed_version": { "type": "string" },
              "cvss_score": { "type": "number" },
              "ecosystem": { "type": "string" }
            }
          }
        }
      }
    },
    "discarded_claims": {
      "type": "array",
      "items": { "$ref": "#/properties/findings/items" }
    },
    "cross_panel": {
      "type": "object",
      "required": ["integration_findings"],
      "properties": {
        "integration_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["location", "panels", "finding_ids"],
            "properties": {
              "location": {
                "type": "object",
                "properties": {
                  "file": {"type": "string"},
                  "line_start": {"type": "integer"},
                  "line_end": {"type": "integer"}
                }
              },
              "panels": {"type": "array", "items": {"type": "string"}},
              "categories": {"type": "array", "items": {"type": "string"}},
              "finding_ids": {"type": "array", "items": {"type": "string"}},
              "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
              "confidence": {"type": "string", "enum": ["CERTAIN", "LIKELY", "POSSIBLE", "NOTE"]},
              "summary": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
