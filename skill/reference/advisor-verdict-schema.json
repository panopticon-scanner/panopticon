{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PanopticonAdvisorVerdict",
  "type": "object",
  "required": [
    "finding_id",
    "verdict",
    "confidence",
    "reasoning",
    "explored",
    "references",
    "citations"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "minLength": 1,
      "description": "Optional (#1054): the tool-advisor path echoes no run_id (the driver writes no verify-queue.json for it and match_verdict binds on finding_id alone), and the advisor prompt example omits it. Allowed if a host stamps it, never required."},
    "finding_id": {"type": "string"},
    "verdict": {
      "type": "string",
      "enum": ["CONFIRMED", "REJECTED", "NEEDS_MORE_INFO"]
    },
    "confidence": {
      "type": "string",
      "enum": ["CERTAIN", "LIKELY", "POSSIBLE"]
    },
    "reasoning": {"type": "string"},
    "explored": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "array", "items": {"type": "string"}},
    "citations": {
      "type": "object",
      "properties": {
        "cwe": {"type": "array", "items": {"type": "string"}},
        "owasp": {"type": "array", "items": {"type": "string"}},
        "cve": {"type": "array", "items": {"type": "string"}}
      }
    },
    "code": {"type": "string"},
    "stage": {"type": "string", "enum": ["primary", "backup"], "default": "primary"},
    "schema_version": {"type": "integer", "description": "Format/schema version of the advisor verdict."}
  }
}
