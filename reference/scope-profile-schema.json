{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScopeProfile",
  "type": "object",
  "required": ["group", "languages", "surfaces", "risk", "lenses", "panels"],
  "properties": {
    "group": {"type": "string"},
    "facet": {"type": ["string", "null"]},
    "languages": {"type": "array", "items": {"type": "string"}},
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["db_sql", "http_web", "auth", "crypto", "fs", "concurrency",
                 "external_api", "money_pii", "serialization", "templating", "secrets_config",
                 "architecture", "database"]
      }
    },
    "size": {"type": "object", "properties": {"files": {"type": "integer"}, "loc": {"type": "integer"}}},
    "has_tests": {"type": "boolean"},
    "risk": {"type": "string", "enum": ["low", "med", "high"]},
    "facet_scope": {
      "type": "object",
      "properties": {"files": {"type": "array", "items": {"type": "string"}}, "rationale": {"type": "string"}}
    },
    "lenses": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "spawn"],
          "properties": {
            "name": {"type": "string"},
            "spawn": {"type": "boolean"}
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["code", "test", "security", "architecture", "database", "redteam"]
      }
    },
    "tools": { "type": "array", "items": { "type": "string" } },
    "has_deps": { "type": "boolean" }
  }
}
