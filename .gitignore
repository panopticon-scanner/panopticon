__pycache__/
*.py[cod]
*.egg-info/
# Run artifacts. The glob matters: a preserved run gets renamed (e.g.
# .panopticon.prev-20260803), and a bare `.panopticon/` would stop matching it
# — which is how 3.1MB of run-1 scratch was once committed by accident.
.panopticon*/
.superpowers/
.worktrees/

# Local secrets (NVD_API_KEY for dependency-check's BuildKit secret).
# Never commit: the key is a credential, and `docker build --secret`
# reads it from the environment, not from the repo.
.env
.env.*
!.env.example

# Local Claude Code settings — also the write-guard hook's install target.
# install->uninstall is not a byte-clean round-trip, so keep it out of the tree
# so the clean-tree compromise check never false-flags a run (#436).
.claude/settings.local.json

# OS / editor noise
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Runtime artifacts
groups.json
CodeReviewReport_*.json


# Internal process docs live in the private panopticon-docs repo; docs/superpowers
# is a local symlink into it. See panopticon-scanner/panopticon-docs.
# No trailing slash: git's dir-only match ("docs/superpowers/") would not ignore
# the symlink itself, so a fresh checkout would show it untracked.
docs/superpowers
