{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "semanticVersion": "1.171.0",
          "rules": [
            {
              "id": "python.django.security.django-no-csrf-token.django-no-csrf-token",
              "name": "python.django.security.django-no-csrf-token.django-no-csrf-token",
              "shortDescription": {
                "text": "Semgrep Finding: python.django.security.django-no-csrf-token.django-no-csrf-token"
              },
              "fullDescription": {
                "text": "Manually-created forms in django templates should specify a csrf_token to prevent CSRF attacks."
              },
              "help": {
                "text": "Manually-created forms in django templates should specify a csrf_token to prevent CSRF attacks.",
                "markdown": "Manually-created forms in django templates should specify a csrf_token to prevent CSRF attacks.\n\n<b>References:</b>\n - [Semgrep Rule](https://semgrep.dev/r/python.django.security.django-no-csrf-token.django-no-csrf-token)\n - [https://docs.djangoproject.com/en/4.2/howto/csrf/](https://docs.djangoproject.com/en/4.2/howto/csrf/)\n"
              },
              "helpUri": "https://semgrep.dev/r/python.django.security.django-no-csrf-token.django-no-csrf-token",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "very-high",
                "tags": [
                  "CWE-352: Cross-Site Request Forgery (CSRF)",
                  "MEDIUM CONFIDENCE",
                  "security"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.django.security.django-no-csrf-token.django-no-csrf-token",
          "level": "warning",
          "message": {
            "text": "Manually-created forms in django templates should specify a csrf_token to prevent CSRF attacks."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/src/templates/program_detail.html",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 63,
                  "startColumn": 5,
                  "endLine": 69,
                  "endColumn": 12,
                  "snippet": {
                    "text": "    <form\n        method=\"post\"\n        action=\"/programs/{{ program.id }}/generate\"\n        class=\"d-inline\"\n    >\n        <button type=\"submit\" class=\"btn btn-br\">Generate Distro</button>\n    </form>"
                  }
                }
              }
            }
          ],
          "fingerprints": {
            "matchBasedId/v1": "requires login"
          },
          "properties": {}
        }
      ]
    }
  ]
}
