   "advisory": {
    "path": "/root/.local/share/ruby-advisory-db/gems/activestorage/CVE-2026-33174.yml",
    "id": "CVE-2026-33174",
    "url": "https://github.com/rails/rails/security/advisories/GHSA-r46p-8f7g-vvvg",
    "title": "Rails Active Storage has a possible DoS vulnerability when in proxy mode via Range requests",
    "date": "2026-03-23",
    "description": "### Impact\nWhen serving files through Active Storage's `Blobs::ProxyController`,\nthe controller loads the entire requested byte range into memory before sending it.\nA request with a large or unbounded Range header (e.g. `bytes=0-`) could cause the server\nto allocate memory proportional to the file size, possibly resulting in a DoS vulnerability through memory exhaustion.\n\n### Releases\nThe fixed releases are available at the normal locations.\n",
    "cvss_v2": null,
