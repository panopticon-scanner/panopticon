    "hooks-path-traversal.py": [
      "import json",
      "import os",
      "import pathlib",
      "import shutil",
      "",
      "",
      "def preparse_reads_are_not_json_derived(control_path, result_path, stream_path):",
      "    controls = json.loads(pathlib.Path(control_path).read_text(encoding=\"utf-8\"))",
      "    result = json.loads(pathlib.Path(result_path).read_text(encoding=\"utf-8\"))",
      "    payload = json.loads(open(stream_path, encoding=\"utf-8\").read())",
      "    document = json.load(open(stream_path, encoding=\"utf-8\"))",
      "    return controls, result, payload, document",
      "",
      "",
      "def real_json_derived_paths(raw, stream):",
      "    payload = json.loads(raw)",
      "    open(payload[\"open_path\"], encoding=\"utf-8\")",
      "    os.remove(payload[\"remove_path\"])",
      "",
      "    document = json.load(stream)",
      "    os.unlink(document[\"unlink_path\"])",
      "    shutil.copy(document[\"copy_source\"], \"/tmp/destination\")",
      "    shutil.move(document[\"move_source\"], \"/tmp/destination\")",
      "    pathlib.Path(document[\"path_object\"])",
      "",
      "    open(json.loads(raw)[\"direct_open\"], encoding=\"utf-8\")",
      "    pathlib.Path(json.load(stream)[\"direct_path\"])",
      "",
      "",
      "def sanitized_json_derived_paths(raw):",
      "    payload = json.loads(raw)",
      "    open(os.path.realpath(payload[\"path\"]), encoding=\"utf-8\")",
      "    os.remove(os.path.abspath(payload[\"path\"]))",
      "",
      "",
      "def unrelated_paths_are_clean(path):",
      "    open(path, encoding=\"utf-8\")",
      "    pathlib.Path(path)"
    ],
