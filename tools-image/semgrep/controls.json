      "        print(\"Hello \" + name)",
      "    \"\"\"))",
      "    # dynamic Python launch",
      "    program = subprocess.Popen(['python2', str(python_file)], stdin=subprocess.PIPE, text=True)",
      "    program.communicate(input=payload, timeout=1)",
