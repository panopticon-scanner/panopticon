      "queue_id": "002-INJ-001",
      "priority": 1,
      "finding": {
        "id": "INJ-001",
        "severity": "HIGH",
        "panel": "security",
        "lens": "injection",
        "category": "injection",
        "location": {
          "file": "skill/scripts/run_fixture_tests.py",
          "line_start": 53,
          "line_end": 58,
          "function": "check_fixtures"
        },
        "title": "OS command injection via unsanitized shell script construction",
        "description": "check_fixtures builds a shell script by f-string interpolating manifest paths into 'if [ -d \"{p}\" ]...' and runs it via sh -c. Paths containing shell metacharacters execute as commands.",
        "impact": "An attacker able to modify tests/fixtures/manifest.json executes arbitrary commands in the container context.",
        "remediation": "shlex.quote() the paths, or drop the shell entirely and pass a list argv (e.g. ['test','-d',p]).",
        "references": [
          "https://cwe.mitre.org/data/definitions/78.html",
          "https://owasp.org/www-community/attacks/Command_Injection"
        ],
        "source_role": "lens_sweep",
